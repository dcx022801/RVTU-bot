# RVTU-bot 环境变量配置模板
# 可选：生产环境用 digest 固定镜像（推荐；不填则用 latest）
# RVTU_IMAGE=ghcr.io/dcx022801/rvtu-bot@sha256:<digest>
# 用法：复制本文件为 .env（同目录），填写下面的值后 docker compose up -d --build
# 说明：CREDS_USER 去空白后非空即启用 .env 注入模式（全部配置以本文件为准，无需再编辑 config/ 目录）
#      仅空白会拒绝启动；占位符/非法 MAC/坐标会在启动时直接报错。

# ===== 登录凭据（必填）=====
# 身份证号：考勤 / 晚自习 / 校园网认证 统一账号
CREDS_USER=
# 统一密码
CREDS_PASS=

# ===== 邮件通知（不填则不发邮件，也不发打卡前提醒）=====
# 只有填写 MAIL_USER/MAIL_PASSWORD/MAIL_SENDER/MAIL_TO 才会启用邮件；
# 下面默认的 host/port 不会单独启用邮件。
# SMTP 服务器地址（163 邮箱固定为 smtp.163.com）
MAIL_HOST=smtp.163.com
# SMTP 端口（SSL 加密一般为 465）
MAIL_PORT=465
# 邮箱账号（163 邮箱即完整邮箱地址）
MAIL_USER=
# 邮箱授权码（在邮箱设置中开启 SMTP 后获取；不是登录密码）
MAIL_PASSWORD=
# 发件邮箱（一般与 MAIL_USER 相同）
MAIL_SENDER=
# 收件邮箱（多个用英文逗号分隔）
MAIL_TO=

# ===== 晚自习打卡 MAC 池（必填）=====
# 打卡点 AP 的 MAC 列表，英文逗号分隔，格式 AA:BB:CC:DD:EE:FF（需要几条写几条）
MACS=

# ===== 定位通道坐标（必填）=====
# 纬度（MAC 通道全部失败时，回退定位通道使用）
LOCATION_LAT=
# 经度
LOCATION_LON=
# 打卡点地点描述（服务端展示用）
LOCATION_INFO=

# ===== 校园网认证 =====
# 被认证网卡 MAC（认证请求参数 umac；留空则自动解析：302 跳转值优先，其次本机网卡）
PORTAL_UMAC=
# 上联设备 MAC（认证请求参数 apmac；留空则传空）
PORTAL_UPLINK_MAC=
# 允许提交账号密码的门户主机白名单（主机名或 IP，英文逗号分隔）
# 必填：留空且 PORTAL_ALLOW_ANY 不为 1 时，脚本默认拒绝提交凭据（fail-closed）
# 可从现有 portal-auth.log 的 "redirected, auth -> https://主机/..." 行获取合法主机
PORTAL_ALLOWED_HOSTS=
# 允许的协议，默认 https,http
PORTAL_ALLOWED_SCHEMES=https,http
# 仅临时排障使用：1 = 跳过 host 白名单（不安全，默认 0）
PORTAL_ALLOW_ANY=0
# MAC 分隔符：auto / colon / hyphen（auto 按 302 参数或本机网卡自动选择）
PORTAL_MAC_FORMAT=auto
