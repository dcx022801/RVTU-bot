# RVTU-bot 环境变量配置模板
# 用法：复制本文件为 .env（同目录），填写下面的值后 docker compose up -d --build
# 说明：填了 CREDS_USER 即启用 .env 注入模式（全部配置以本文件为准，无需再编辑 config/ 目录）

# ===== 登录凭据（必填）=====
# 身份证号：考勤 / 晚自习 / 校园网认证 统一账号
CREDS_USER=
# 统一密码
CREDS_PASS=

# ===== 邮件通知（不填则不发邮件，也不发打卡前提醒）=====
# SMTP 服务器地址（163 邮箱固定为 smtp.163.com）
MAIL_HOST=smtp.163.com
# SMTP 端口（SSL 加密一般为 465）
MAIL_PORT=465
# 邮箱账号（163 邮箱即完整邮箱地址）
MAIL_USER=
# 邮箱授权码（在邮箱设置中开启 SMTP 后获取；不是登录密码）
MAIL_PASSWORD=
# 发件邮箱（一般与 MAIL_USER 相同）
MAIL_SENDER=
# 收件邮箱（多个用英文逗号分隔）
MAIL_TO=

# ===== 晚自习打卡 MAC 池（必填）=====
# 打卡点 AP 的 MAC 列表，英文逗号分隔，格式 AA:BB:CC:DD:EE:FF（需要几条写几条）
MACS=

# ===== 定位通道坐标（必填）=====
# 纬度（MAC 通道全部失败时，回退定位通道使用）
LOCATION_LAT=
# 经度
LOCATION_LON=
# 打卡点地点描述（服务端展示用）
LOCATION_INFO=

# ===== 校园网认证（两个指定 MAC，建议填写）=====
# 被认证网卡 MAC（认证请求参数 umac；留空则自动解析：302 跳转值优先，其次本机网卡）
PORTAL_UMAC=
# 上联设备 MAC（认证请求参数 apmac；留空则传空）
PORTAL_UPLINK_MAC=
